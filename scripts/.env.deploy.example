# Copy to .env.deploy (gitignored) and fill in.
# Anything you don't set here falls back to the defaults baked into deploy.sh.

# ── REQUIRED ───────────────────────────────────────────────────────────────
PORTAINER_USER=admin
PORTAINER_PASS=replace-me

# ── Portainer target ───────────────────────────────────────────────────────
# PORTAINER_URL=http://192.168.13.202:9000
# PORTAINER_ENDPOINT=2          # numeric endpoint id (from Portainer UI)

# ── Image & container ──────────────────────────────────────────────────────
# IMAGE=se8:latest
# CONTAINER=se8
# HOST_PORT=8765                # exposed on the NAS
# CONTAINER_PORT=8000           # internal, matches Dockerfile EXPOSE
# VOL_HOST_PATH=/volume1/docker/se8/vol   # bind-mounted into /app/vol

# ── Runtime tuning ─────────────────────────────────────────────────────────
# WORKER_COUNT=8                # SE8_WORKER_COUNT env var
# TZ_VAL=Asia/Shanghai
# DNS1=8.8.8.8
# DNS2=1.1.1.1
# NOCACHE=1                     # 1 = always rebuild, 0 = reuse layers

# ── Health check ───────────────────────────────────────────────────────────
# HEALTHCHECK_URL=http://192.168.13.202:8765/healthz
